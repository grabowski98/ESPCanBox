   "crop": {"element": "#ota-s2"}},
  {"id": "ota-too-short", "title": "Wizard step 2: file too short",
   "steps": [{"tab": "system"}, {"upload_fw": "short", "name": "firmware.bin"}, {"wait": "#ota-file-info .bad"}],
   "crop": {"element": "#ota-s2"}},
  {"id": "ota-ready", "title": "Wizard: file checked, same mode, ready to send", "viewports": ["desktop", "phone"],
   "steps": [{"tab": "system"}, {"upload_fw": "listen", "name": "espcanbox-listen_wifi-{next}.bin"}, {"wait": "#ota-file-info .ok"}],
   "crop": {"element": ".card:has(#ota-state)"}, "crop_phone": "viewport",
   "steps_phone": [{"scroll": "#ota-s2", "block": "center"}]},
  {"id": "system-firmware-wizard", "title": "Wizard: a decoder file for a listen-only device needs an explicit tick",
   "langs": ["en", "pl"],
   "steps": [{"tab": "system"}, {"upload_fw": "decoder", "name": "espcanbox-decoder_wifi-{next}.bin"}, {"wait": "#ota-acks .ack"}],
   "crop": {"element": "#ota-s2"}},
  {"id": "ota-cantx-ack", "title": "Wizard: a file that can transmit on CAN needs its own tick",
   "mock": {"mode": "decoder", "car": {"ignition": "engine", "park": {"rear": "waiting", "front": "waiting"}}},
   "steps": [{"tab": "system"}, {"upload_fw": "decoder_tx", "name": "espcanbox-decoder_tx_wifi-{next}.bin"}, {"wait": "#ota-acks .ack"}],
   "crop": {"element": "#ota-s2"}},
  {"id": "ota-nonet-ack", "title": "Wizard: a file without the network panel (no way back over Wi-Fi)",
   "steps": [{"tab": "system"}, {"upload_fw": "nonet", "name": "espcanbox-listen-{next}.bin"}, {"wait": "#ota-acks .ack"}],
   "crop": {"element": "#ota-s2"}},
  {"id": "ota-confirm-dialog", "title": "Wizard step 3: last confirmation before sending",
   "steps": [{"tab": "system"}, {"upload_fw": "listen", "name": "espcanbox-listen_wifi-{next}.bin"}, {"wait": "#ota-file-info .ok"},
             {"click": "#btn-ota"}, {"wait": "#modal:not([hidden])"}]},
  {"id": "ota-pending", "title": "New firmware running, waiting to be confirmed",
   "steps": [{"tab": "system"}, {"upload_fw": "listen", "name": "espcanbox-listen_wifi-{next}.bin"}, {"wait": "#ota-file-info .ok"},
             {"click": "#btn-ota"}, {"wait": "#modal:not([hidden])"}, {"click": "#modal-ok"},
             {"wait_js": "document.getElementById('ota-state').textContent.indexOf('{next} ') >= 0", "timeout": 30000}, {"sleep": 600}],
   "crop": {"element": ".card:has(#ota-state)"}},
  {"id": "ota-done", "title": "Update finished and confirmed; rollback to the previous firmware offered",
   "steps": [{"tab": "system"}, {"upload_fw": "listen", "name": "espcanbox-listen_wifi-{next}.bin"}, {"wait": "#ota-file-info .ok"},
             {"click": "#btn-ota"}, {"wait": "#modal:not([hidden])"}, {"click": "#modal-ok"},
             {"wait": "#ota-msg.ok", "timeout": 60000}],
   "crop": {"element": ".card:has(#ota-state)"}},
  {"id": "ota-rollback-dialog", "title": "Rollback to the previous firmware: confirmation",
   "steps": [{"tab": "system"}, {"upload_fw": "listen", "name": "espcanbox-listen_wifi-{next}.bin"}, {"wait": "#ota-file-info .ok"},
             {"click": "#btn-ota"}, {"wait": "#modal:not([hidden])"}, {"click": "#modal-ok"},
             {"wait": "#ota-msg.ok", "timeout": 60000}, {"click": "#btn-rollback"}, {"wait": "#modal:not([hidden])"}]},
  {"id": "system-restart-dialog", "title": "Restart of the device: confirmation",
   "steps": [{"tab": "system"}, {"click": "#btn-restart"}, {"wait": "#modal:not([hidden])"}]},
  {"id": "system-restart-pending", "title": "Restart scheduled: the panel waits for the device to come back",
   "steps": [{"tab": "system"}, {"scroll": "#btn-restart", "block": "center"}, {"click": "#btn-restart"}, {"wait": "#modal:not([hidden])"},
             {"click": "#modal-ok"}, {"wait": "#ota-msg.warn"}], "settle": 0},
  {"id": "system-restarted", "title": "Device back after the restart: the console marks it, the start-up lines follow",
   "steps": [{"tab": "konsola"}, {"wait_js": "document.querySelectorAll('#log-view > *').length >= 1"}, {"console": "ver"}, {"sleep": 600},
             {"tab": "system"}, {"scroll": "#btn-restart", "block": "center"}, {"click": "#btn-restart"}, {"wait": "#modal:not([hidden])"},
             {"click": "#modal-ok"}, {"wait": "#ota-msg.ok", "timeout": 30000},
             {"wait": "#toast.show", "state": "hidden", "timeout": 15000}, {"tab": "konsola"}, {"sleep": 1500}],
   "expect_text": ["the device has restarted"], "settle": 300},

  {"id": "offline", "title": "No connection to the device: red banner, the panel keeps the last values",
   "langs": ["en", "pl"], "viewports": ["desktop", "phone"],
   "mock": {"car": {"ignition": "engine", "outside_temp": 6.5, "park": {"rear": "waiting", "front": "waiting"}}},
   "steps": [{"sleep": 800}, {"stop_mock": true}, {"wait": "#banner.bad", "timeout": 20000}], "settle": 300}
 ]
}
