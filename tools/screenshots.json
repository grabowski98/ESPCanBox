   "crop": {"element": ".car-card"}},
  {"id": "dashboard-tablet", "file": "panel-dashboard.png", "title": "Dashboard on a tablet: reverse gear, rear sensors beeping", "viewports": ["tablet"],
   "mock": {"car": {"ignition": "engine", "reverse": true, "lights": true, "outside_temp": 6.5,
            "park": {"rear": "active", "rear_zones": [6, 3, 7], "front": "waiting", "sound": "rear", "interval": 18}}}},
