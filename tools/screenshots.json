{
 "_comment": [
  "Scene list for tools/make_screenshots.py. One scene = one state of the web panel, shown by the mock device.",
  "Fields: id (file panel-<id>.png unless 'file' is given; phone files panel-phone-<id>.png, other languages in <lang>/),",
  "title (what the image shows), langs (default [en]), viewports (desktop 1280x800, tablet 820x1180, phone 390x844),",
  "scheme (dark | light; the panel follows the browser), crop ('viewport' | 'full' | {element: CSS selector, pad: px}),",
  "  or {elements: [selectors]} (the box around all of them), pad_top (another top margin), hide (cards left out),",
  "crop_<viewport> (another crop for that viewport), height (taller desktop viewport), height_<viewport>,",
  "login (false = stay on the login screen), remember (tick 'Remember on this device' at login),",
  "browser_lang (language of the browser's own controls, default: the scene language),",
  "expect_text / absent_text (texts that must / must not be on the page, or the scene gets a warning),",
  "mock: {car: {...} | capture: path under firmware/, mode: listen | decoder, can_tx, lan, lan_admin, demo_radio,",
  "  supply_v (12 V input after the diode; default from the ignition: engine 13.42, on 11.63, off 11.71, none 0 = USB)},",
  "  car: ignition none|off|on|engine, lights, reverse, outside_temp, doors [driver, passenger, rear_left, rear_right, boot],",
  "  park: {rear, front: none|off|active|waiting|failed, rear_zones / front_zones [3 x 0..7], sound: rear|front, interval 0..63}",
  "  (a synthetic capture with those frames is written to a temporary directory and replayed by the mock),",
  "before (console commands sent before the page opens), before_restart (restart the mock after them),",
  "warmup (s before the page opens), settle (ms before the shot), fixed_time (Date.now fixed to 2026-02-10 10:00 UTC),",
  "steps (steps_<viewport>: extra steps for that viewport only): tab, click, fill+value, press+key, check, select+value, wait (selector), wait_js (expression), sleep (ms),",
  "  console (type a command), api_cmd (command through the API, as from USB beforehand), api_restart, stop_mock,",
  "  upload_fw (listen | decoder | decoder_tx | nonet | other_product | not_app | short; version default {next}),",
  "  upload_json (settings backup file: object or text), expand_select, scroll (+block), scroll_bottom, hover, eval.",
  "Placeholders: {password} (random mock password), {wrong1}..{wrong8}, {version} (firmware/src/version.h), {next} (next patch version)."
 ],
 "defaults": {
  "langs": ["en"],
  "viewports": ["desktop"],
  "scheme": "dark",
  "crop": "viewport",
  "mock": {"car": {"ignition": "engine", "outside_temp": 6.5, "park": {"rear": "waiting", "front": "waiting"}}}
 },
 "scenes": [
  {"id": "login", "title": "Login screen with the language picker", "login": false,
   "langs": ["en", "pl"], "viewports": ["desktop", "phone"]},
  {"id": "login-remember", "title": "Login with 'Remember on this device' ticked", "login": false,
   "steps": [{"fill": "#login-pw", "value": "{password}"}, {"check": "#login-remember"}],
   "crop": {"element": "#login-form"}},
  {"id": "login-wrong-password", "title": "Login refused: wrong password", "login": false,
   "steps": [{"fill": "#login-pw", "value": "{wrong1}"}, {"click": "#login-form button[type=submit]"}, {"wait": "#login-msg.bad"}]},
  {"id": "login-locked-out", "title": "Login lockout after five wrong passwords from the home network", "login": false,
   "mock": {"lan": true, "car": {"ignition": "engine", "park": {"rear": "waiting", "front": "waiting"}}},
   "steps": [
    {"fill": "#login-pw", "value": "{wrong1}"}, {"click": "#login-form button[type=submit]"}, {"sleep": 500},
    {"fill": "#login-pw", "value": "{wrong2}"}, {"click": "#login-form button[type=submit]"}, {"sleep": 500},
    {"fill": "#login-pw", "value": "{wrong3}"}, {"click": "#login-form button[type=submit]"}, {"sleep": 500},
    {"fill": "#login-pw", "value": "{wrong4}"}, {"click": "#login-form button[type=submit]"}, {"sleep": 500},
    {"fill": "#login-pw", "value": "{wrong5}"}, {"click": "#login-form button[type=submit]"}, {"sleep": 500},
    {"fill": "#login-pw", "value": "{wrong6}"}, {"click": "#login-form button[type=submit]"},
    {"wait": "#banner.bad"}]},

  {"id": "dashboard", "title": "Dashboard, listen-only build, engine running, front sensors beeping",
   "langs": ["en", "pl"], "viewports": ["desktop", "phone"], "crop": "full", "crop_phone": "viewport",
   "mock": {"car": {"ignition": "engine", "lights": true, "outside_temp": 6.5,
            "park": {"rear": "waiting", "front": "active", "front_zones": [5, 3, 7], "sound": "front", "interval": 24}}}},
  {"id": "dashboard-light", "title": "Dashboard in the light scheme", "scheme": "light",
   "mock": {"car": {"ignition": "engine", "lights": true, "outside_temp": 6.5,
            "park": {"rear": "waiting", "front": "active", "front_zones": [5, 3, 7], "sound": "front", "interval": 24}}}},
  {"id": "dashboard-decoder", "title": "Dashboard of the decoder build (the device talks to the radio)", "crop": "full",
   "mock": {"mode": "decoder", "car": {"ignition": "engine", "outside_temp": 6.5, "park": {"rear": "waiting", "front": "waiting"}}}},
  {"id": "dashboard-decoder-tx", "title": "Build with CAN transmission, disarmed: warning and the two buttons on the CAN bus card",
   "langs": ["en", "pl"], "crop": "full",
   "mock": {"mode": "decoder", "can_tx": true, "car": {"ignition": "engine", "outside_temp": 6.5, "park": {"rear": "waiting", "front": "waiting"}}}},
  {"id": "dashboard-cantx-arm-dialog", "title": "Arming CAN transmission: the dialog with its warnings",
   "langs": ["en", "pl"], "viewports": ["desktop", "phone"],
   "mock": {"mode": "decoder", "can_tx": true, "car": {"ignition": "engine", "park": {"rear": "waiting", "front": "waiting"}}},
   "steps": [{"click": "#btn-cantx-on"}, {"wait": "#modal:not([hidden])"}]},
  {"id": "dashboard-cantx-arm-stored", "title": "Arming stored: it takes effect after a restart",
   "mock": {"mode": "decoder", "can_tx": true, "car": {"ignition": "engine", "park": {"rear": "waiting", "front": "waiting"}}},
   "steps": [{"click": "#btn-cantx-on"}, {"wait": "#modal:not([hidden])"}, {"click": "#modal-ok"}, {"wait": "#toast.show"}, {"sleep": 700}],
   "settle": 200, "crop": {"element": ".card:has(#kv-can)"}},
  {"id": "dashboard-cantx-armed", "title": "Armed after the restart: header badge 'CAN: armed', gate ready", "crop": "full",
   "mock": {"mode": "decoder", "can_tx": true, "car": {"ignition": "engine", "park": {"rear": "waiting", "front": "waiting"}}},
   "before": ["cantx on"], "before_restart": true},
  {"id": "dashboard-cantx-home-network", "title": "Transmit build opened from the home network: arming only from the device network",
   "mock": {"mode": "decoder", "can_tx": true, "lan": true, "car": {"ignition": "engine", "park": {"rear": "waiting", "front": "waiting"}}},
   "crop": {"element": ".card:has(#kv-can)"}},
  {"id": "dashboard-bus-silent", "title": "No CAN traffic (on the bench, USB power): every car value says 'no frame', the bus dot is amber",
   "crop": {"element": ".car-card"},
   "mock": {"car": {"ignition": "none"}}},
  {"id": "dashboard-ignition-off", "title": "Ignition off: ACC has gone off, the car still talks on the bus", "crop": {"element": ".car-card"}, "warmup": 3.5,
   "mock": {"car": {"ignition": "off", "outside_temp": 4.0}}},
  {"id": "dashboard-ignition-on", "title": "Ignition on, engine not running", "crop": {"element": ".car-card"},
   "mock": {"car": {"ignition": "on", "outside_temp": 4.0, "park": {"rear": "waiting", "front": "waiting"}}}},
  {"id": "dashboard-engine-running", "title": "Engine running, sensors waiting", "crop": {"element": ".car-card"},
   "mock": {"car": {"ignition": "engine", "outside_temp": 6.5, "park": {"rear": "waiting", "front": "waiting"}}}},
  {"id": "dashboard-lights-on", "title": "Lights on: the Lights chip is lit", "crop": {"element": ".car-card"},
   "mock": {"car": {"ignition": "engine", "lights": true, "outside_temp": 2.5, "park": {"rear": "waiting", "front": "waiting"}}}},
  {"id": "dashboard-park-rear", "title": "Reverse gear: rear sensors active and beeping", "crop": {"elements": [".car-card", ".card:has(#kv-park)"], "hide": [".card:has(#kv-radio-dash)", ".card:has(#kv-can)"]},
   "mock": {"car": {"ignition": "engine", "reverse": true, "outside_temp": 6.5,
            "park": {"rear": "active", "rear_zones": [4, 2, 5], "front": "waiting", "sound": "rear", "interval": 12}}}},
  {"id": "dashboard-park-front-rear", "title": "Front and rear sensors active at the same time", "langs": ["en", "pl"], "crop": {"elements": [".car-card", ".card:has(#kv-park)"], "hide": [".card:has(#kv-radio-dash)", ".card:has(#kv-can)"]},
   "mock": {"car": {"ignition": "engine", "reverse": true, "outside_temp": 6.5,
            "park": {"rear": "active", "rear_zones": [6, 4, 7], "front": "active", "front_zones": [3, 1, 5], "sound": "front", "interval": 10}}}},
  {"id": "dashboard-park-continuous", "title": "Obstacle very close: continuous tone", "viewports": ["desktop", "phone"],
   "crop": {"elements": [".car-card", ".card:has(#kv-park)"], "hide": [".card:has(#kv-radio-dash)", ".card:has(#kv-can)"]}, "crop_phone": "viewport",
   "steps_phone": [{"scroll": ".card:has(#kv-park)", "block": "end"}],
   "mock": {"car": {"ignition": "engine", "outside_temp": 6.5,
            "park": {"rear": "waiting", "front": "active", "front_zones": [7, 0, 6], "sound": "front", "interval": 0}}}},
  {"id": "dashboard-park-off", "title": "Parking sensors switched off with the car button", "crop": {"elements": [".car-card", ".card:has(#kv-park)"], "hide": [".card:has(#kv-radio-dash)", ".card:has(#kv-can)"]},
   "mock": {"car": {"ignition": "engine", "outside_temp": 6.5, "park": {"rear": "off", "front": "off"}}}},
  {"id": "dashboard-doors-open", "title": "Driver door and boot open", "crop": {"element": ".car-card"},
   "absent_text": ["all closed"],
   "mock": {"car": {"ignition": "on", "outside_temp": 6.5, "doors": ["driver", "boot"], "park": {"rear": "waiting", "front": "waiting"}}}},
  {"id": "dashboard-test-beep", "title": "Test beep running from the parking sensors card",
