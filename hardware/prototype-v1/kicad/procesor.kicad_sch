		)
		(uuid "a1751e78-e8d7-5227-8791-518aef1ea705")
	)
	(text "Numbering from the antenna end. Row spacing: 22.86 mm\n(measured, same as DevKitC-1).\nUSB, BOOT/RESET buttons, RGB LED (IO38) and the 3.3 V regulator\nare on the module; its 3V3 output also supplies the CAN module and I2C. IO35-IO37 are used by the module memory: do not use.\nIO0, IO45, IO46 are strapping pins: left free. IO3: emergency button."
		(exclude_from_sim no)
		(at 20.32 45.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "22ac26a1-6f0e-536e-ab29-0a6b42bdd7fe")
	)
