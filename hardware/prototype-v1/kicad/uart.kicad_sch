	(text "UART TO THE RADIO (decoder mode)"
		(exclude_from_sim no)
		(at 20.32 20.32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "015f1be0-dee3-534a-bbc3-613309105bd0")
	)
	(text "1k in the transmit line. 4k7 in the receive line: safe also with a 5 V level from the radio.\nSolder jumpers JP_UART select which connector line is transmit and which is receive\n(direction measured on the reference car: the radio transmits on RADIO_A = upper 7, receives on RADIO_B = lower 8). Solder 2-3 on both;\n1-2 on both = reversed (other harness).\nPads marked \"do not fit\": divider for a 5 V level on the radio side and filter capacitors."
		(exclude_from_sim no)
		(at 20.32 45.72 0)
		(effects
