	(text "ADAFRUIT CAN PAL MODULE (TJA1051T/3), plugged into a 1x7 socket"
		(exclude_from_sim no)
		(at 20.32 20.32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "107f2738-67b6-5e4b-9b25-abea1156db6d")
	)
	(text "Two transmit locks, both in hardware:\nJP_TX open: the module TX line floats, the transceiver stays recessive.\nJP_S in position 1-2: SLNT tied to +3V3, transmitter off (listen only).\nJP_S in position 2-3: the processor sets the mode (CAN_S, high = listen only).\nR_SLNT pulls SLNT up: after a processor reset the board only listens.\nTerminator switch on the module: OFF (the car has its own terminators)."
		(exclude_from_sim no)
		(at 20.32 50.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6b51753b-00cf-5940-9f82-18fa8018b952")
	)
